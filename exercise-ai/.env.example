# Provedor LLM: gemini | openai | grok (opcional; auto-detecta pela chave disponível)
# LLM_PROVIDER=gemini

# Esforço de raciocínio/thinking: none | low | medium | high (padrão medium)
# Sobrescrito pela flag CLI --reasoning. Grok/Gemini honoram; gpt-4o-mini omite.
# LLM_REASONING_EFFORT=medium

# OpenAI API Key (formato: sk-...)
LLM_API_KEY=

# Google Gemini API Key (formato: AIza...)
GEMINI_API_KEY=

# xAI Grok API Key (OpenAI-compatible; base_url https://api.x.ai/v1)
GROK_API_KEY=

# Regenerações após a primeira tentativa (0–3). Padrão 1 se omitido.
# Sobrescrito pela flag CLI --max-retries. Sem segredos.
# RELY_MAX_RETRIES=1
