# Provedor LLM: gemini | openai (opcional; auto-detecta pela chave disponível)
# LLM_PROVIDER=gemini

# OpenAI API Key (formato: sk-...)
LLM_API_KEY=

# Google Gemini API Key (formato: AIza...)
GEMINI_API_KEY=

# Regenerações após a primeira tentativa (0–3). Padrão 1 se omitido.
# Sobrescrito pela flag CLI --max-retries. Sem segredos.
# RELY_MAX_RETRIES=1
